# Required, always. Server refuses to boot without it. Use a long random string.
JWT_SECRET=

# Required in production only (server refuses to boot without it when NODE_ENV=production).
# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Outside production, defaults to http://localhost:5173 (Vite's default port) if unset.
CORS_ALLOWED_ORIGINS=

# Optional. Defaults to 5001.
PORT=

# Optional. development | test | production. Defaults to development.
# (Vitest sets this to "test" automatically — you shouldn't need to set it yourself locally.)
NODE_ENV=

# Optional. pino log level: trace | debug | info | warn | error | fatal | silent.
# Defaults to info (silent when NODE_ENV=test).
LOG_LEVEL=

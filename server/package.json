{
    "name": "server",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "dev": "tsx watch src/server.ts",
        "build": "npm run typecheck",
        "start": "tsx src/server.ts",
        "start:prod": "knex migrate:latest --knexfile knexfile.ts && knex seed:run --knexfile knexfile.ts && npm run start",
        "build:prod": "npm_config_build_from_source=true npm install --include=dev && npm run build && npm prune --omit=dev",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "engines": {
        "node": ">=26.0.0"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^9.1.0",
        "@scalar/express-api-reference": "^0.10.13",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "knex": "^3.3.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "sqlite3": "^6.0.1",
        "tsx": "^4.23.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.1.2",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.6",
        "supertest": "^7.2.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.10"
    }
}
